		(uuid "2ffc1cbe-fbab-43b8-b38f-8318cbc90b8e")
	)
	(text "POWER & CONNECTORS. J1 = main board (spec v1.3), J2 = FTDI console. Two LM66100 ideal diodes OR the two\n5 V inputs with ~25 mV drop (a Schottky would cost 350 mV of LED headroom). F1 protects the cable,\nD1 clamps surges, FB1 + C2 keep the LED current steps on the board. U3 makes 3.3 V (also the ADC reference)."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "0353176a-363a-42e0-acc1-036b76317c34")
	)
