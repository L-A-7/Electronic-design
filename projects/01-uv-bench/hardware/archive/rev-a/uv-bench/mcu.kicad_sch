	)
	(text "MCU STM32C031F6P6 (TSSOP-20). Pin map: docs/design-synthesis.md §5. Pin 16 = PA9 (TIM1_CH2, GATE) and\npin 17 = PA12 (status LED) need the SYSCFG remap (CubeMX). J3 = 10-pin Cortex debug (ST-LINK).\nJP1 open = I2C address 0x2A, closed = 0x2B. C at VDD: 100 nF right at the pin + 4.7 uF bulk."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "e1c51213-dd25-4f21-8321-8adb3d1130fb")
	)
