	(text "LED DRIVER"
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left top)
		)
		(uuid "6252d491-0557-4a5e-a261-14b313889656")
	)
	(text "LED DRIVER: linear current sink, I_LED = V(SET_G) / R_sense, 0..100 mV -> 0..303 mA (hardware max).\nPWM 47 kHz -> 2-pole RC (160 Hz) with divider. U6 disconnects the setpoint (dark gaps / off) without\ndisturbing the filter. U7: LED enabled only if GATE (MCU) AND ARM_OK (manual ARM switch on J6).\nNT1 = net tie: Kelvin sense taken at the R_sense pad. Compensation R/C: tune with simulation S2."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "0f36077a-d56d-42ea-bd93-a6cae3974c54")
	)
