	(text "PHOTODIODE AND MONITORS"
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left top)
		)
		(uuid "b6b94189-a432-419f-ba53-f9c1d1874953")
	)
	(text "PHOTODIODE TIA: V(PD_OUT) = 0.1 V + I_pd x 1 MOhm, bandwidth ~ 1/(2 pi Rf Cf) ~ 70 kHz. The +0.1 V bias\nkeeps the output off the 0 V rail so (LED on - LED off) stays linear. D4 (DNP) = alternative detector\n(385-395 nm LED as photodiode) in parallel with D3. Dividers /2 for V_HEAD and V_IN; NTC divider for T_LED."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "c48a88c4-16e7-4c15-8567-c0fe6ac3fab6")
	)
